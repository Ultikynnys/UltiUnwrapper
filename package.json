  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "three": "^0.185.1"
  }
}
